{
  "feature_engineering": {
    "multiview_architecture": "5-branch FeatureUnion",
    "branches": [
      {
        "name": "char",
        "type": "TfidfVectorizer",
        "analyzer": "char",
        "ngram_range": [
          1,
          5
        ],
        "max_features": 180000,
        "sublinear_tf": true
      },
      {
        "name": "word",
        "type": "TfidfVectorizer",
        "token_pattern": "\\S+",
        "ngram_range": [
          1,
          2
        ],
        "max_features": 150000,
        "sublinear_tf": true
      },
      {
        "name": "boundary",
        "type": "TfidfVectorizer",
        "analyzer": "char_wb",
        "ngram_range": [
          3,
          5
        ],
        "max_features": 100000,
        "sublinear_tf": true
      },
      {
        "name": "punct",
        "type": "TfidfVectorizer",
        "token_pattern": "(?u)\\b\\w+\\b|[^\\w\\s]",
        "ngram_range": [
          1,
          2
        ],
        "max_features": 100000,
        "sublinear_tf": true
      },
      {
        "name": "style",
        "type": "RichStylometricExtractor + StandardScaler",
        "features_count": 110,
        "weight": 0.2
      }
    ],
